{
  "name": "@icurbe/switchboard",
  "version": "3.4.0",
  "description": "Supervised inter-agent messaging relay for Claude Code (and any MCP client). Named identities, channels with focused conversations (threads), per-conversation state docs (PROGRESS.md), single-pane supervision UI with manual-approval mode.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "switchboard": "bin/switchboard.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/switchboard.js start",
    "mcp": "node bin/switchboard.js mcp",
    "dev": "node --watch bin/switchboard.js start",
    "test": "node --test",
    "tailwind:build": "tailwindcss -i src/ui/static/tailwind.input.css -o src/ui/static/tailwind.css --minify",
    "tailwind:watch": "tailwindcss -i src/ui/static/tailwind.input.css -o src/ui/static/tailwind.css --watch"
  },
  "keywords": [
    "claude-code",
    "mcp",
    "agent-communication",
    "inter-agent",
    "relay",
    "supervision",
    "ai-agents",
    "loops",
    "conversations"
  ],
  "author": "Hector Curbelo Barrios <hcurbelo@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Curbeloi/switchboard.git"
  },
  "bugs": {
    "url": "https://github.com/Curbeloi/switchboard/issues"
  },
  "homepage": "https://github.com/Curbeloi/switchboard#readme",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@homebridge/node-pty-prebuilt-multiarch"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ajv": "^8.20.0",
    "express": "^4.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cytoscape": "3.30.2",
    "tailwindcss": "^3.4.0"
  }
}
