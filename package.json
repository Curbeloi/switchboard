{
  "name": "@icurbe/switchboard",
  "version": "2.8.0",
  "description": "Supervised inter-agent messaging relay for Claude Code (and any MCP client). Named identities, channel-based pub/sub, single-pane supervision UI with manual-approval mode.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "switchboard": "bin/switchboard.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/switchboard.js start",
    "mcp": "node bin/switchboard.js mcp",
    "dev": "node --watch bin/switchboard.js start",
    "test": "node --test tests/"
  },
  "keywords": [
    "claude-code",
    "mcp",
    "agent-communication",
    "inter-agent",
    "relay",
    "supervision",
    "ai-agents"
  ],
  "author": "Hector Curbelo Barrios <hcurbelo@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Curbeloi/switchboard.git"
  },
  "bugs": {
    "url": "https://github.com/Curbeloi/switchboard/issues"
  },
  "homepage": "https://github.com/Curbeloi/switchboard#readme",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ajv": "^8.20.0",
    "express": "^4.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
